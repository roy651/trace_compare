# Only the two LLM commands (design-rules, diagnose) need credentials.
# `demo` and `compare` make no model calls. Copy this file to .env and fill in what applies.

# Model to use when --model is not passed. Any LiteLLM model string:
# https://docs.litellm.ai/docs/providers
LLM_MODEL=anthropic/claude-opus-4-6

# Option A: your provider's standard variable. Set the one that matches LLM_MODEL.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# WATSONX_APIKEY=          # also WATSONX_URL and WATSONX_PROJECT_ID
# AZURE_API_KEY=           # also AZURE_API_BASE and AZURE_API_VERSION

# Option B: one key for whichever provider LLM_MODEL names.
# LLM_API_KEY=

# Option C: an OpenAI-compatible endpoint (company gateway, LiteLLM proxy, vLLM, Ollama).
# LLM_MODEL is passed through to it unchanged.
# LLM_BASE_URL=
# LLM_API_KEY=
